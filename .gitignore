# Ignore everything at root level, then whitelist what matters.
# Note: git cannot re-include a file whose parent folder is excluded, so every
# level is opened with "!dir/" and then closed again with "dir/*".
/*

# ── Top-level files & folders to keep ──────────────────────────────────────
!/.gitignore
!/.gitmodules
!/main.py
!/README.md
!/LICENSE
!/COMMERCIAL_LICENSE.md
!/requirements.txt
!/examples/
!/utl/
!/STRUCTURE/
!/FLUID/
!/COUPLING/
!/docs/
!/output_data/

# ── examples: only the published cases, config + README ────────────────────
/examples/*
!/examples/__init__.py
!/examples/config.py
!/examples/GOLAND/
!/examples/GOLAND_water/
!/examples/TFOIL_SIMPLE/
!/examples/Model2t/
/examples/*/*
!/examples/*/config_*.py
!/examples/*/README.md
# geometry of the case, imported by FEA, SHARPy and Capytaine (not a script)
!/examples/TFOIL_SIMPLE/tfoil_simple_geom.py

# ── STRUCTURE/FEA ───────────────────────────────────────────────────────────
/STRUCTURE/*
!/STRUCTURE/FEA/
!/STRUCTURE/SONATA/
# anba4 is a git submodule (see .gitmodules)
!/STRUCTURE/anba4

# Ignore FEA sub-folders that are not part of the workflow
STRUCTURE/FEA/9_gitclone/
STRUCTURE/FEA/1_beams/
STRUCTURE/FEA/hydrofoils/
STRUCTURE/FEA/old/

# ── STRUCTURE/SONATA ────────────────────────────────────────────────────────
/STRUCTURE/SONATA/*
!/STRUCTURE/SONATA/__init__.py
!/STRUCTURE/SONATA/README.md
!/STRUCTURE/SONATA/hollowell-1982/
!/STRUCTURE/SONATA/AGARD445.6/
!/STRUCTURE/SONATA/ETNZ/
!/STRUCTURE/SONATA/NACA0012/
!/STRUCTURE/SONATA/NACA0015/
!/STRUCTURE/SONATA/wing01/

# ── FLUID ───────────────────────────────────────────────────────────────────
/FLUID/*
!/FLUID/aerodynamic_model.py
!/FLUID/hydro/
!/FLUID/PanelAero/
!/FLUID/capytaine/
!/FLUID/sharpy/

# PanelAero: code only (Qjj / Quvlm tables and CAERO1 cards are regenerated)
FLUID/PanelAero/panelaero_utl/old/
/FLUID/PanelAero/Qjj/*
!/FLUID/PanelAero/Qjj/*.py

# capytaine: workflow code + docs, and the meshes of the published cases
/FLUID/capytaine/*
!/FLUID/capytaine/*.py
!/FLUID/capytaine/*.md
!/FLUID/capytaine/*.txt
!/FLUID/capytaine/GOLAND_water/
!/FLUID/capytaine/Model2t/
/FLUID/capytaine/*/*
!/FLUID/capytaine/*/*.py
!/FLUID/capytaine/GOLAND_water/GOLAND_water_mesh.vtu
!/FLUID/capytaine/Model2t/Model2t_mesh.vtu

# sharpy: vendored source + local patches + gino_bem (its own .gitignore drops
# build/, *.so, outputs); lib/UVLM and lib/xbeam are submodules
/FLUID/sharpy/.git-upstream/

# ── docs: resources + the two reference PDFs ───────────────────────────────
/docs/*
!/docs/resources/
!/docs/26-04-07_thesis_Lorenzo-Valle.pdf
!/docs/GINO – Technical Overview and Validation.pdf

# ── output_data: one reference result per published case ──────────────────
/output_data/*
!/output_data/GOLAND/
!/output_data/GOLAND_water/
!/output_data/TFOIL_SIMPLE/
!/output_data/Model2t/

/output_data/GOLAND/*
!/output_data/GOLAND/framework_comparison/

/output_data/GOLAND_water/*
!/output_data/GOLAND_water/README.md
!/output_data/GOLAND_water/casoA_numeric_revD/
!/output_data/GOLAND_water/casoB_numericSteel_revD/
!/output_data/GOLAND_water/report/
/output_data/GOLAND_water/report/*
!/output_data/GOLAND_water/report/*revD.pdf

/output_data/TFOIL_SIMPLE/*
!/output_data/TFOIL_SIMPLE/core_fk0.5_tck0.18_Ec110_Gc4.5_rf100_rc600_rs600_sk0.6_ks0.04_xea0.35_tc0.12_edx-200*/

/output_data/Model2t/*
!/output_data/Model2t/00_baseline_sensitivity/
/output_data/Model2t/00_baseline_sensitivity/*
!/output_data/Model2t/00_baseline_sensitivity/*.png
!/output_data/Model2t/00_baseline_sensitivity/*.md
!/output_data/Model2t/00_baseline_sensitivity/_baseline_GINO_DLM_only/
!/output_data/Model2t/00_baseline_sensitivity/_baseline_GINO_UVLM_only/
!/output_data/Model2t/00_baseline_sensitivity/_baseline_GINO_UVLM_BEM/
!/output_data/Model2t/00_baseline_sensitivity/_baseline_sharpy_deltainjection_plusbem/

# heavy binaries stay local (they are regenerated by the chain)
/output_data/**/*.h5
/output_data/**/*.bak
/output_data/**/*.pptx
/output_data/**/_archive/
/output_data/**/old/
/output_data/**/*.log
# per-iteration / per-k diagnostic images (~150 MB), not results
/output_data/**/cp_k*_allmodes.png
/output_data/**/qmodal_pk_iterations_*.png
/output_data/**/debug_mesh_*.png
# files > 5 MB
/output_data/Model2t/00_baseline_sensitivity/_baseline_sharpy_deltainjection_plusbem/model2t_sharpy_eigvecs_nm4.npz

# ── Python cache — always excluded ──────────────────────────────────────────
**/__pycache__/
**/*.pyc
**/*.pyo
**/*.pyd

# ── Backups ─────────────────────────────────────────────────────────────────
.backup*/
