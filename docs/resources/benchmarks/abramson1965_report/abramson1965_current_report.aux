\@writefile{toc}{\contentsline {section}{\numberline {1}Riferimento sperimentale}{1}{section.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Riferimenti grafici dal paper Abramson e Ransleben (1965).\relax }}{1}{figure.caption.1}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {2}Verifica degli input}{2}{section.2}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Confronto tra input del paper e configurazione numerica corrente.\relax }}{2}{table.caption.2}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {3}Metodo numerico usato nella run corrente}{2}{section.3}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {4}Risultati correnti}{3}{section.4}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Curve $V-\Lambda $, $V-g$ e $V-f$ prodotte dalla run corrente. Il solver individua $V_F=\SI {6.82}{\meter \per \second }=\SI {13.3}{\knunit }$ sulla seconda branca ($f_F\approx \SI {23.1}{\hertz }$).\relax }}{3}{figure.caption.3}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Contributi modali di massa, rigidezza e smorzamento. La convenzione usata nel codice e' $M_\mathrm  {eff}=M_\mathrm  {struct}-M_\mathrm  {aero}+M_\mathrm  {hydro}$, $K_\mathrm  {eff}=K_\mathrm  {struct}-K_\mathrm  {aero}$, $C_\mathrm  {eff}=C_\mathrm  {struct}-C_\mathrm  {aero}+C_\mathrm  {hydro}+C_\mathrm  {emp}$.\relax }}{3}{figure.caption.4}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Confronto tra contributi strutturali modali $(\hat  {C},\hat  {K})$ e valori effettivi dopo il contributo DLM/RFA $(C_\mathrm  {eff},K_\mathrm  {eff})$.\relax }}{3}{figure.caption.5}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Termini di massa aggiunta Capytaine usati nella correzione idroelastica, confrontati con la stima da strip theory. La discrepanza principale e' sui termini diagonali: Capytaine aumenta $m_{11}$ rispetto alla strip theory e riduce $m_{22}$.\relax }}{4}{figure.caption.6}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {5}Analisi alternative: PK e strip theory}{4}{section.5}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Analisi PK senza correzione strip theory (run precedente). Il flutter e' stimato intorno a \SI {8.4}{\knunit }; la frequenza della seconda branca cresce rapidamente, mentre la branca 1 rimane a frequenze piu' basse.\relax }}{4}{figure.caption.7}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Analisi PK con massa aggiunta da strip theory. L'andamento delle frequenze bagnate rimane plausibile, ma il log decrement e il damping mostrano ancora una scala molto distante dai punti sperimentali di Abramson.\relax }}{5}{figure.caption.8}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces Analisi RFA con massa aggiunta da strip theory. Il flutter viene individuato intorno a \SI {7.5}{\knunit }; anche in questa variante la frequenza bagnata segue un trend regolare, mentre la magnitudine dei decrementi resta il punto critico.\relax }}{5}{figure.caption.9}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {6}Confronto con figure 5 e 6 ridigitalizzate}{5}{section.6}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces Confronto sul decadimento/log decrement: i punti sperimentali di Abramson sono riportati insieme ai dati branch 1 e branch 2 del pannello $V-\Lambda $ della run corrente, senza applicare ulteriori flip di segno. La seconda branca numerica attraversa lo zero intorno a \SI {13.3}{\knunit }, mentre il riferimento sperimentale arriva a circa \SI {48}{\knunit }.\relax }}{6}{figure.caption.10}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {10}{\ignorespaces Confronto sulla frequenza: l'andamento delle frequenze bagnate e' qualitativamente coerente con il riferimento, in particolare per la branca torsionale, ma l'instabilita' numerica avviene molto prima del punto di rottura misurato.\relax }}{6}{figure.caption.11}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {7}Conclusione}{6}{section.7}\protected@file@percent }
