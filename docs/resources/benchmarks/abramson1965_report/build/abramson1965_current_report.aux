\@writefile{toc}{\contentsline {section}{\numberline {5}Analisi alternative: PK e strip theory}{7}{section.5}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces Analisi PK senza correzione strip theory (run precedente). Il flutter e' stimato intorno a \SI {11.2}{\knunit }; la frequenza del secondo ramo cresce e decresce rapidamente, mentre il primo ramo rimane a frequenze piu' basse. Il grafico log decrement method è altissimo, rispetto a risultati sperimentali.\relax }}{8}{figure.caption.13}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces Analisi PK con massa aggiunta da strip theory. L'andamento delle frequenze bagnate è più plausibile, risulta più basso, data la presenza di più massa aggiunta strip, ma il log decrement e il damping mostrano ancora una scala molto alta per validare i risultati. Molto distante dai punti sperimentali di Abramson.\relax }}{8}{figure.caption.14}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {10}{\ignorespaces Analisi RFA con massa aggiunta da strip theory. Il flutter viene individuato intorno a \SI {12.6}{\knunit }; anche in questa variante la frequenza bagnata segue un trend regolare, mentre la magnitudine dei decrementi resta il punto critico. Questo plot che coincide con risultato pk, permette di validare metodo RFA.\relax }}{8}{figure.caption.15}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {6}Confronto con figure 5 e 6 ridigitalizzate}{9}{section.6}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {11}{\ignorespaces Confronto sul decadimento/log decrement: i punti sperimentali di Abramson sono riportati insieme ai dati branch 1 e branch 2 del pannello $V-\Lambda $ della run corrente, senza applicare ulteriori flip di segno. La seconda branca numerica attraversa lo zero intorno a \SI {13.3}{\knunit }, mentre il riferimento sperimentale arriva a circa \SI {48}{\knunit }.\relax }}{9}{figure.caption.16}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {12}{\ignorespaces Confronto sulla frequenza: l'andamento delle frequenze bagnate e' qualitativamente coerente con il riferimento, in particolare per la branca torsionale, ma l'instabilita' numerica avviene molto prima del punto di rottura misurato.\relax }}{10}{figure.caption.17}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {7}Conclusione}{10}{section.7}\protected@file@percent }
