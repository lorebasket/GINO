\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Curve $V-\Lambda $, $V-g$ e $V-f$ prodotte dalla run corrente. Il solver individua $V_F=\SI {6.82}{\meter \per \second }=\SI {13.3}{\knunit }$ sulla seconda branca ($f_F\approx \SI {23.1}{\hertz }$).\relax }}{3}{figure.caption.3}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Contributi modali di massa, rigidezza e smorzamento. La convenzione usata nel codice e' $M_\mathrm  {eff}=M_\mathrm  {struct}-M_\mathrm  {aero}+M_\mathrm  {hydro}$, $K_\mathrm  {eff}=K_\mathrm  {struct}-K_\mathrm  {aero}$, $C_\mathrm  {eff}=C_\mathrm  {struct}-C_\mathrm  {aero}+C_\mathrm  {hydro}+C_\mathrm  {emp}$.\relax }}{3}{figure.caption.4}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Confronto tra contributi strutturali modali $(\hat  {C},\hat  {K})$ e valori effettivi dopo il contributo DLM/RFA $(C_\mathrm  {eff},K_\mathrm  {eff})$.\relax }}{3}{figure.caption.5}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Termini di massa aggiunta modale generalizzata usati nella correzione idroelastica ($m_{11}$, $m_{12}$, $m_{21}$, $m_{22}$), confrontati tra Capytaine e strip theory proiettata sugli stessi modi strutturali. I valori sono costanti con $V$ (Capytaine asintotica; strip indipendente dalla velocita'). Non vanno confusi con la massa aggiunta fisica totale dell'ala.\relax }}{4}{figure.caption.6}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {4.1}Massa fisica totale, massa strutturale modale e massa aggiunta modale}{4}{subsection.4.1}\protected@file@percent }
