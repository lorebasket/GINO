\@writefile{toc}{\contentsline {paragraph}{Massa aggiunta fisica totale (strip theory, moto rigido).}{4}{section*.8}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Massa aggiunta modale generalizzata (quella nel plot e in $M_\mathrm  {eff}$).}{5}{section*.9}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Massa aggiunta modale $A(\omega )$ da Capytaine (BEM) per due profondita' di immersione. A basse frequenze compaiono piccole oscillazioni; per $\omega \gtrsim \SI {50}{\radian \per \second }$ i termini diagonali convergono ai valori asintotici $A_{11}\approx \SI {1.31}{\kilogram }$, $A_{22}\approx \SI {0.28}{\kilogram }$ usati nel flutter solver. Le due profondita' (\SI {0.0508}{\meter } e \SI {0.052}{\meter }) producono curve quasi sovrapposte.\relax }}{6}{figure.caption.10}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:capytaine-added-mass-omega}{{6}{6}{Massa aggiunta modale $A(\omega )$ da Capytaine (BEM) per due profondita' di immersione. A basse frequenze compaiono piccole oscillazioni; per $\omega \gtrsim \SI {50}{\radian \per \second }$ i termini diagonali convergono ai valori asintotici $A_{11}\approx \SI {1.31}{\kilogram }$, $A_{22}\approx \SI {0.28}{\kilogram }$ usati nel flutter solver. Le due profondita' (\SI {0.0508}{\meter } e \SI {0.052}{\meter }) producono curve quasi sovrapposte.\relax }{figure.caption.10}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Smorzamento radiativo modale $B(\omega )$ da Capytaine. I picchi sono concentrati a basse frequenze ($\omega \approx \SI {6}{\radian \per \second }$--\SI {10}{\radian \per \second }); oltre $\omega \approx \SI {25}{\radian \per \second }$ il damping radiativo tende a zero. Nella run corrente il solver usa $B_\infty \approx 0$ (media asintotica ad alta $\omega $), coerente con queste curve nella banda di flutter ($\omega \sim \SI {60}{\radian \per \second }$--\SI {130}{\radian \per \second }).\relax }}{7}{figure.caption.11}\protected@file@percent }
\newlabel{fig:capytaine-radiation-damping-omega}{{7}{7}{Smorzamento radiativo modale $B(\omega )$ da Capytaine. I picchi sono concentrati a basse frequenze ($\omega \approx \SI {6}{\radian \per \second }$--\SI {10}{\radian \per \second }); oltre $\omega \approx \SI {25}{\radian \per \second }$ il damping radiativo tende a zero. Nella run corrente il solver usa $B_\infty \approx 0$ (media asintotica ad alta $\omega $), coerente con queste curve nella banda di flutter ($\omega \sim \SI {60}{\radian \per \second }$--\SI {130}{\radian \per \second }).\relax }{figure.caption.11}{}}
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Riepilogo delle scale di massa per ABRAMSON1965 (primi due modi).\relax }}{7}{table.caption.12}\protected@file@percent }
